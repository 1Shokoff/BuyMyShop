# ---------------------------------------------------------------- инфраструктура
# Адрес, который слушает Caddy.
#   example.com  боевой режим, сертификат Let's Encrypt выпускается автоматически
#   :80          проверка по IP без домена: только HTTP, без сертификата
SITE_DOMAIN=example.com

POSTGRES_USER=buymyshop
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=buymyshop

# ------------------------------------------------------------------------ общее
SITE_NAME=BuyMyShop
PUBLIC_BASE_URL=https://example.com
# openssl rand -hex 32
SECRET_KEY=change-me-please-32-bytes-hex
DEBUG=false
DISPLAY_TIMEZONE=Asia/Magadan
SUPPORT_CONTACT=@your_telegram
ORDER_TTL_MINUTES=30

# ------------------------------------------------------------------------ товар
PRODUCT_CODE=main
PRODUCT_TITLE=Название товара
PRODUCT_PRICE=990.00
PRODUCT_CURRENCY=RUB

# ------------------------------------------------- поле с 15-значным числом
CUSTOMER_FIELD_LABEL=ID клиента
CUSTOMER_FIELD_HINT=15 цифр, без пробелов и дефисов
CUSTOMER_FIELD_PATTERN=^\d{15}$
CUSTOMER_FIELD_ERROR=Введите ровно 15 цифр.
# Галочка «я проверил ID»: исправить его после оплаты нельзя
REQUIRE_REF_CONFIRMATION=true
COLLECT_EMAIL=true
REQUIRE_EMAIL=false

# --------------------------------------------------------------------- telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ATTEMPTS=12

# ------------------------------------------------------------------------ админ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# ------------------------------------------------------------------- провайдеры
# Тестовый провайдер без реальных денег — включать только на стенде.
DUMMY_ENABLED=false

YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1

ROBOKASSA_ENABLED=false
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH_ALGORITHM=md5
ROBOKASSA_TEST_MODE=false

LAVA_ENABLED=false
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
LAVA_OFFER_ID=

ENOT_ENABLED=false
ENOT_SHOP_ID=
ENOT_SECRET_KEY=
ENOT_ADDITIONAL_KEY=
